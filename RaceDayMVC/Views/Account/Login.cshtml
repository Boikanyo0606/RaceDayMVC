@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white"><h4>Login to RaceDay</h4></div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Login" method="post">
                    <div class="mb-3"><label>Email</label><input name="email" class="form-control" required /></div>
                    <div class="mb-3"><label>Password</label><input name="password" type="password" class="form-control" required /></div>
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>
                <p class="mt-3 text-center">No account? <a asp-action="Register">Register here</a></p>
            </div>
        </div>
    </div>
</div>