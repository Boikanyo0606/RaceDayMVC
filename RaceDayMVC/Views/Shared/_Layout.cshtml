<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDayMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Changed to bg-primary navbar-dark for a more energetic/sporting look -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">🏃 RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var token = Context.Session.GetString("Token");
                            var role = Context.Session.GetString("Role");
                            var email = Context.Session.GetString("Email");
                        }

                        @if (token != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light">Welcome, @email (@role)</span>
                            </li>

                            @if (role == "Organiser")
                            {
                                <li class="nav-item"><a class="nav-link text-light" asp-controller="Events" asp-action="Index">My Events</a></li>
                                <li class="nav-item"><a class="nav-link text-light" asp-controller="Results" asp-action="Index">Record Results</a></li>
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Index">Browse Events</a></li>
                                <li class="nav-item"><a class="nav-link text-light" asp-controller="Enrollments" asp-action="MyResults">My Results</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (token != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a></li>
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Account" asp-action="Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center py-3">
            &copy; 2026 - RaceDay - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>